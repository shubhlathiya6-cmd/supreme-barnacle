{
  "name": "3dringscatlog380",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone 3D ring catalog viewer (380 designs) extracted from the Brisha secret-vault",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "upload:r2": "node scripts/upload-r2.mjs jewelry-assets ring380models 8",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=ring-vault"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.10",
    "clsx": "^2.1.1",
    "gsap": "^3.14.2",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  }
}
